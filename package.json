{
  "name": "vct-registry",
  "version": "1.0.0",
  "main": "index.js",
  "license": "BSD-2-Clause",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "knex": "^3.3.0",
    "mysql2": "^3.24.5",
    "wallet-common": "git+https://github.com/wwWallet/wallet-common.git#v2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "concurrently": "10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "prettier": "^3.8.0",
    "supertest": "^7.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "8.3.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --names server,react \"yarn dev:server\" \"yarn dev:react\"",
    "dev:server": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:react": "yarn --cwd frontend dev",
    "build": "rm -rf dist && tsc && cp -R public dist/public && yarn build:react",
    "build:react": "yarn --cwd frontend build",
    "typecheck": "tsc --noEmit && yarn --cwd frontend typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "start": "node dist/src/server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "migration:run": "knex migrate:latest",
    "migration:revert": "knex migrate:rollback"
  }
}
