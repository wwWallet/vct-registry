{% extends "layouts/base.njk" %}

{% block title %}vct-registry{% endblock %}

{% block page_styles %}
<link rel="stylesheet" href="./styles/add.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jsoneditor@latest/dist/jsoneditor.min.css" />
<link rel="stylesheet" href="./styles/jsoneditor.css" />
{% endblock %}

{% block content %}
<section class="page-shell">
  <div class="page-header">
    <h2>Create Verifiable Credential Type Metadata</h2>
    <p class="page-subtitle">
      Create a new registry entry by defining the type identifier and supplying its full metadata document.
    </p>
  </div>
  <div class="editor-layout">
    <section class="card page-card editor-sidebar">
      <div class="metadata-panel-header">
        <h3>Details</h3>
        <p class="metadata-panel-copy">Define the credential identity and preview how the metadata card will render.</p>
      </div>

      <div class="metadata-type-field">
        <label class="metadata-stat-label" for="metadata-type">Type:</label>
        <select id="metadata-type" class="registry-select">
          <option value="dc+sd-jwt">dc+sd-jwt</option>
          <option value="mso_mdoc">mso_mdoc</option>
        </select>
      </div>

      <dl class="registry-meta editor-meta">
        <div class="metadata-stat">
          <dt class="metadata-stat-label">Identifier</dt>
          <dd id="edit-metadata-identifier-value" class="metadata-stat-value metadata-stat-code"><code></code></dd>
        </div>
        <div class="metadata-stat">
          <dt class="metadata-stat-label">Name</dt>
          <dd id="edit-metadata-name-value" class="metadata-stat-value">-</dd>
        </div>
        <div class="metadata-stat metadata-preview-stat">
          <dt class="metadata-stat-label">Preview</dt>
          <dd class="metadata-stat-value">
            <div id="metadata-preview-list" class="metadata-preview-list" hidden></div>
            <p id="metadata-preview-empty" class="editor-preview-empty">Preview will appear when metadata includes display information.</p>
          </dd>
        </div>
        <div class="metadata-stat metadata-stat-description">
          <dt class="metadata-stat-label">Description</dt>
          <dd id="edit-metadata-description" class="metadata-stat-value">No description provided yet.</dd>
        </div>
      </dl>
    </section>

    <section class="card page-card editor-main">
      <div class="metadata-panel-header">
        <h3>Metadata JSON</h3>
        <p class="metadata-panel-copy">Edit the full type metadata document directly.</p>
      </div>
      <div id="registry-info" class="info">URI integrity values will be calculated on submission using SHA-256.
        Existing integrity values will be tested and replaced if they do not match the metadata content.</div>
      <div id="jsoneditor" class="jsoneditor-host"></div>
      <div class="registry-edit-button-container">
        <a class="registry-btn registry-btn-cancel" href="./metadata">Cancel</a>
        <button id="registry-submit-btn" type="button" class="registry-btn registry-edit-btn submit" disabled>Create type metadata</button>
      </div>

      <div id="registry-error" class="error" hidden></div>
      <div id="registry-success" class="success" hidden></div>
    </section>
  </div>
</section>
{% endblock %}

{% block page_scripts %}
<script src="https://cdn.jsdelivr.net/npm/jsoneditor@latest"></script>
<script type="module" src="./js/add.js"></script>
<script type="module" src="./js/uri-integrity.js"></script>
{% endblock %}
