{% extends "layouts/base.njk" %}

{% block title %}vct-registry{% endblock %}

{% block page_styles %}
<link rel="stylesheet" href="./styles/index.css" />
{% endblock %}

{% block content %}
<div id="registry-success" class="success" hidden></div>

<section class="page-shell metadata-shell">
  <div class="page-header metadata-hero-copy">
    <h2>Verifiable Credential Type Metadata</h2>
    <p class="page-subtitle metadata-description">
      Explore one credential definition at a time or inspect the full registry payload. This page is optimized for both quick browsing and raw JSON review.
    </p>
  </div>

  <div id="registry-add" class="metadata-header-action">
    <a id="registry-add-btn" class="registry-btn registry-btn-outline registry-btn-action metadata-add-btn" href="add" hidden>Add new credential</a>
  </div>

  {% if metadataError %}
  <div class="error">{{ metadataError }}</div>
  {% elif metadataList and metadataList.length %}
  <section class="card page-card metadata-selection-panel">
    <div class="metadata-panel-header">
      <h3>Selection</h3>
      <p class="metadata-panel-copy">Choose a type metadata entry to inspect a single record, or switch to the complete registry response.</p>
    </div>

    <div class="metadata-selection-row">
      <form id="registry-select-form" class="metadata-select-form" method="GET" action="metadata">
          <select id="registry-select" class="registry-select" name="identifier" onchange="this.form.submit()">
            <option value="__all__" {% if selectedIdentifier == "__all__" %}selected{% endif %}>(All metadata)</option>
            {% for entry in metadataList %}
            <option value="{{ entry.identifier }}" {% if selectedIdentifier == entry.identifier %}selected{% endif %}>
              {{ entry.name }} ({{ entry.identifier }})
            </option>
            {% endfor %}
          </select>
      </form>

      <div id="registry-edit" class="registry-edit" {% if selectedIdentifier == "__all__" %}hidden{% endif %}>
        <form id="registry-edit-form" method="GET" action="edit">
          <input id="registry-edit-value" type="hidden" name="identifier" value="{{ selectedIdentifier }}">
          <button id="registry-edit-btn" class="registry-btn registry-btn-outline registry-btn-action metadata-edit-btn" type="submit" hidden>Edit metadata</button>
        </form>
      </div>
    </div>
  </section>

  <div class="metadata-layout">
    <section class="card page-card metadata-sidebar">
      <div class="metadata-panel-header">
        <h3>Details</h3>
      </div>

      <div id="registry-controls" class="registry-controls">
        <dl id="registry-meta" class="registry-meta">
          {% if selectedIdentifier == "__all__" %}
          <div class="metadata-stat">
            <dt class="metadata-stat-label">Showing</dt>
            <dd class="metadata-stat-value">All metadata entries</dd>
          </div>
          <div class="metadata-stat">
            <dt class="metadata-stat-label">Total entries</dt>
            <dd class="metadata-stat-value">{{ metadataList.length }}</dd>
          </div>
          <div class="metadata-stat">
            <dt class="metadata-stat-label">Source</dt>
            <dd class="metadata-stat-value copy-inline-row metadata-stat-code">
              <code id="metadata-source-value">GET {{ sourceUrl }}</code>
              {% set copyTarget = "#metadata-source-value" %}
              {% set copyLabel = "Copy source" %}
              {% set copyButtonClass = "metadata-copy-btn" %}
              {% include "../partials/copy-button.njk" %}
            </dd>
          </div>
          {% elif selectedMetadata %}
          <div class="metadata-stat">
            <dt class="metadata-stat-label">Format</dt>
            <dd class="metadata-stat-value"><code id="metadata-format-value">{{ selectedFormat }}</code></dd>
          </div>
          <div class="metadata-stat">
            <dt class="metadata-stat-label">Identifier</dt>
            <dd class="metadata-stat-value copy-inline-row metadata-stat-code">
              <code id="metadata-identifier-value">{{ selectedMetadata.identifier }}</code>
              {% set copyTarget = "#metadata-identifier-value" %}
              {% set copyLabel = "Copy identifier" %}
              {% set copyButtonClass = "metadata-copy-btn" %}
              {% include "../partials/copy-button.njk" %}
            </dd>
          </div>
          <div class="metadata-stat">
            <dt class="metadata-stat-label">Name</dt>
            <dd class="metadata-stat-value">{{ selectedMetadata.name }}</dd>
          </div>
          {% if selectedMetadataPreviewSvgUris and selectedMetadataPreviewSvgUris.length %}
          <div class="metadata-stat metadata-preview-stat">
            <dt class="metadata-stat-label">Preview</dt>
            <dd class="metadata-stat-value">
            <div class="metadata-preview-list">
              {% for preview in selectedMetadataPreviewSvgUris %}
              <figure class="metadata-preview-item">
                <img
                  class="metadata-preview"
                  src="{{ preview.uri }}"
                  alt="{{ selectedMetadata.name or selectedMetadata.identifier or 'Credential' }} preview"
                />
                {% if preview.properties %}
                <figcaption class="metadata-preview-caption">
                  {% if preview.properties.orientation %}{{ preview.properties.orientation }}{% endif %}
                  {% if preview.properties.color_scheme %}{% if preview.properties.orientation %} · {% endif %}{{ preview.properties.color_scheme }}{% endif %}
                  {% if preview.properties.contrast %}{% if preview.properties.orientation or preview.properties.color_scheme %} · {% endif %}{{ preview.properties.contrast }} contrast{% endif %}
                </figcaption>
                {% endif %}
              </figure>
              {% endfor %}
            </div>
            </dd>
          </div>
          {% endif %}
          {% if selectedMetadata.description %}
          <div class="metadata-stat metadata-stat-description">
            <dt class="metadata-stat-label">Description</dt>
            <dd class="metadata-stat-value">{{ selectedMetadata.description }}</dd>
          </div>
          {% endif %}
          <div class="metadata-stat">
            <dt class="metadata-stat-label">Source</dt>
            <dd class="metadata-stat-value copy-inline-row metadata-stat-code">
              <code id="metadata-source-value">GET {{ sourceUrl }}</code>
              {% set copyTarget = "#metadata-source-value" %}
              {% set copyLabel = "Copy source" %}
              {% set copyButtonClass = "metadata-copy-btn" %}
              {% include "../partials/copy-button.njk" %}
            </dd>
          </div>
          {% endif %}
        </dl>

        <div id="registry-delete" class="metadata-delete-action" {% if selectedIdentifier == "__all__" %}hidden{% endif %}>
          <button id="registry-delete-btn" type="button" class="registry-btn registry-edit-btn delete" hidden>Delete credential</button>
        </div>
      </div>
    </section>

    <section class="card page-card metadata-json-panel">
      <div class="metadata-panel-header metadata-json-header">
        <h3>Raw Metadata JSON</h3>
        {% set copyTarget = "#registry-data" %}
        {% set copyLabel = "Copy raw metadata JSON" %}
        {% set copyButtonClass = "metadata-copy-btn metadata-json-copy-btn" %}
        {% include "../partials/copy-button.njk" %}
      </div>
      <pre id="registry-data" class="code-surface registry-data">{{ metadataJson }}</pre>
    </section>
  </div>
  <div class="metadata-inline-error">
    <div id="registry-error" class="error" hidden></div>
  </div>
  {% else %}
  <div class="error">No type metadata entries found.</div>
  {% endif %}
</section>
{% endblock %}

{% block page_scripts %}
<script type="module" src="./js/index.js"></script>
{% endblock %}
