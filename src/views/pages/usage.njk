{% extends "layouts/base.njk" %}

{% block title %}vct-registry usage{% endblock %}

{% block page_styles %}
<link rel="stylesheet" href="./styles/usage.css" />
{% endblock %}

{% block page_scripts %}
<script type="module" src="./js/usage.js"></script>
{% endblock %}

{% block content %}
<section class="page-shell">
  <div class="page-header">
    <h2>How To Fetch Metadata</h2>
    <p class="page-subtitle">
      Use these endpoints from backend services, scripts, or browser clients to integrate with the registry cleanly.
    </p>
  </div>
  <section class="card page-card usage-card">
    <p class="usage-text">
      Registry base URL: <code>{{ registryBaseUrl }}</code>
    </p>

    <h3>1. Fetch All Metadata</h3>
    <p class="usage-text">
      Endpoint: <code>GET {{ registryBaseUrl }}/type-metadata/all</code>
    </p>
    <div class="copy-overlay-block">
      {% set copyTarget = "#usage-code-all" %}
      {% set copyLabel = "Copy example" %}
      {% set copyButtonClass = "usage-copy-btn" %}
      {% include "../partials/copy-button.njk" %}
      <pre class="code-surface usage-code"><code id="usage-code-all">curl -s "{{ registryBaseUrl }}/type-metadata/all"</code></pre>
    </div>

    <p class="usage-text">Optionally filter by format: <code>/type-metadata/all?format=dc%2Bsd-jwt</code>. No matches returns an empty array; unsupported formats return HTTP 400.</p>

    <h3>2. Fetch One Metadata Entry by Identifier</h3>
    <p class="usage-text">
      Endpoint: <code>GET {{ registryBaseUrl }}/type-metadata?identifier=&lt;identifier&gt;</code>
    </p>
    <div class="copy-overlay-block">
      {% set copyTarget = "#usage-code-single" %}
      {% set copyLabel = "Copy example" %}
      {% set copyButtonClass = "usage-copy-btn" %}
      {% include "../partials/copy-button.njk" %}
      <pre class="code-surface usage-code"><code id="usage-code-single">curl -s "{{ registryBaseUrl }}/type-metadata?identifier=urn:eudi:pid:1"</code></pre>
    </div>

    <p class="usage-text">
      For any format, use <code>/type-metadata?identifier=&lt;identifier&gt;</code> (or <code>id</code>).
      Add <code>&amp;format=dc%2Bsd-jwt</code> to constrain the format.
      The <code>vct</code> parameter selects SD-JWT VC metadata.
      Conflicting selectors return HTTP 400. No match returns HTTP 404.
    </p>

    <h3>3. Browser Fetch Example</h3>
    <div class="copy-overlay-block">
      {% set copyTarget = "#usage-code-browser" %}
      {% set copyLabel = "Copy example" %}
      {% set copyButtonClass = "usage-copy-btn" %}
      {% include "../partials/copy-button.njk" %}
      <pre class="code-surface usage-code"><code id="usage-code-browser">const identifier = encodeURIComponent("urn:eudi:pid:1");
const res = await fetch(`{{ registryBaseUrl }}/type-metadata?identifier=${identifier}`);
const metadata = await res.json();
console.log(metadata);</code></pre>
    </div>

    <h3 id="type-metadata-list">4. List All Types (Identifier + Format + Name)</h3>
    <p class="usage-text">
      Endpoint: <code>GET {{ registryBaseUrl }}/type-metadata/list</code>
    </p>
    <div class="copy-overlay-block">
      {% set copyTarget = "#usage-code-list" %}
      {% set copyLabel = "Copy example" %}
      {% set copyButtonClass = "usage-copy-btn" %}
      {% include "../partials/copy-button.njk" %}
      <pre class="code-surface usage-code"><code id="usage-code-list">curl -s "{{ registryBaseUrl }}/type-metadata/list"</code></pre>
    </div>
  </section>
</section>
{% endblock %}
