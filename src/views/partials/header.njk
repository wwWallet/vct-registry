<header class="header" role="banner">
  <div class="header-inner">
    <div class="header-brand-container">
      <a class="header-brand" href="{{ registryBaseUrl or '/' }}">
        <img class="header-logo" src="./images/logo.svg" alt="wwWallet logo" />
        <div class="header-copy">
          <p class="header-kicker">wwWallet</p>
          <h1>VCT Registry</h1>
        </div>
      </a>
    </div>
    <nav class="header-nav" aria-label="Primary">
      <a href="./" class="{% if currentPage == 'home' %}is-active{% endif %}" {% if currentPage == 'home' %}aria-current="page"{% endif %}>Home</a>
      <a href="./metadata" class="{% if currentPage == 'metadata' %}is-active{% endif %}" {% if currentPage == 'metadata' %}aria-current="page"{% endif %}>Metadata</a>
      <a href="./usage" class="{% if currentPage == 'usage' %}is-active{% endif %}" {% if currentPage == 'usage' %}aria-current="page"{% endif %}>Usage</a>
    </nav>
    <div class="registry-auth-button-container">
      <div class="registry-auth-actions">
        <button id="registry-login-btn" type="button" class="registry-btn registry-auth-btn login" {% if isAuthenticated %}hidden disabled{% endif %}>Login</button>
        <div id="registry-auth-dropdown-wrapper" class="avatar-menu" {% if not isAuthenticated %}hidden{% endif %}>
          <button id="username-container" type="button" class="avatar registry-user-indicator registry-auth-dropdown-toggle" {% if isAuthenticated %}data-username="{{ username }}"{% else %}hidden{% endif %} title="Open user menu" aria-label="Open user menu" aria-haspopup="menu" aria-expanded="false" aria-controls="registry-auth-dropdown">
            <span class="registry-user-avatar" aria-hidden="true"></span>
          </button>

          <div id="registry-auth-dropdown" class="dropdown" role="menu" aria-labelledby="username-container" hidden>
            <div class="user-info">
              <div class="label">Signed in as</div>
              <div id="registry-auth-dropdown-username" class="username">{{ username if isAuthenticated else "" }}</div>
            </div>

            <div class="divider"></div>

            <button id="registry-logout-btn" type="button" class="menu-item logout" role="menuitem">Log out</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <dialog id="registry-login-dialog" class="registry-login-dialog" aria-labelledby="registry-login-title">
    <form id="registry-login-form" class="registry-login-form" method="dialog">
      <h2 id="registry-login-title">Login</h2>

      <label class="registry-login-label" for="registry-login-username">Username</label>
      <input id="registry-login-username" name="username" class="registry-login-input" type="text" autocomplete="username" required />

      <label class="registry-login-label" for="registry-login-password">Password</label>
      <input id="registry-login-password" name="password" class="registry-login-input" type="password" autocomplete="current-password" required />

      <p id="registry-login-error" class="registry-login-error" hidden></p>

      <div class="registry-login-actions">
        <button id="registry-login-cancel-btn" type="button" class="registry-btn registry-auth-btn">Cancel</button>
        <button id="registry-login-submit-btn" type="submit" class="registry-btn registry-auth-btn login">Sign in</button>
      </div>
    </form>
  </dialog>
</header>
